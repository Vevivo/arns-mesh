{
  "name": "arns-mesh",
  "productName": "ArNS Mesh Browser",
  "version": "0.5.0-preview.5",
  "type": "module",
  "main": "apps/browser/main.mjs",
  "private": true,
  "description": "Standalone ArNS reader with tabs, bookmarks and verified Mesh content",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "peer": "node apps/peer/main.mjs",
    "check:public": "node scripts/check-public.mjs",
    "profile": "node scripts/profile.mjs",
    "package:windows": "python3 scripts/package-windows.py"
  },
  "dependencies": {
    "@ar.io/sdk": "4.3.1",
    "@ardrive/turbo-upload": "0.3.0",
    "arweave": "1.15.7",
    "hyperswarm": "4.17.1",
    "hyperdht": "6.34.0",
    "bs58": "6.0.0",
    "tweetnacl": "1.0.3",
    "@solana/transactions": "6.10.0",
    "@solana/transaction-messages": "6.10.0",
    "@ar.io/solana-contracts": "1.3.0",
    "@solana/kit": "6.10.0",
    "@ar.io/wayfinder-core": "2.0.2",
    "@dha-team/arbundles": "1.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
